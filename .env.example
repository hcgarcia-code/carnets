# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" con valores reales al repositorio.

SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# Claves de cifrado en reposo de los datos personales del afiliado (RGPD Art. 9).
# OBLIGATORIA: sin ella la aplicación se niega a arrancar (se comprueba en
# GestionConfig.ready) antes que guardar nombres y números de afiliado en claro.
#
# Formato: id:clave_base64,id:clave_base64
# La PRIMERA es la que cifra; las siguientes solo se conservan para poder leer
# lo que se guardó con la clave anterior. Para rotar (mínimo trimestral):
# genera una clave nueva, ponla la primera y deja la anterior detrás.
#
# Generar una clave:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# AVISO DE PRODUCCIÓN: en el servidor esta variable no debe ser un secreto
# estático en el .env. Debe poblarse al arrancar pidiéndosela a un KMS/HSM
# (AWS KMS, Azure Key Vault, HashiCorp Vault). Ver gestion/crypto.py.
CARNETS_ENCRYPTION_KEYS=

# --- Proveedor de las claves de cifrado ---
# Por defecto lee CARNETS_ENCRYPTION_KEYS (arriba). En producción debe apuntar a
# un proveedor de KMS: ver deploy/claves_y_kms.md y deploy/RESTRICCION_UE.md.
# CARNETS_KEY_PROVIDER=gestion.proveedores_kms.proveedor_vault_transit

# --- Caché (sostiene los limitadores de intentos: es seguridad, no rendimiento) ---
# Por defecto, memoria del proceso: vale en local, NO en producción. Con varios
# workers cada uno lleva su propio contador de intentos de login, así que el
# límite de 5 pasa a ser 5 por worker. `manage.py check --deploy` lo rechaza.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://10.0.1.30:6379/1
#
# Alternativa sin montar otro servicio (usa la propia base de datos).
# Necesita ejecutar una vez: manage.py createcachetable
# CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# CACHE_LOCATION=cache_carnets

# --- HTTPS detrás de un proxy que termina el TLS (nginx, PythonAnywhere) ---
# Sin esto, SECURE_SSL_REDIRECT=True provoca un bucle de redirecciones porque
# Django ve la petición interna por HTTP. Actívalo SOLO si el proxy reescribe
# siempre esa cabecera; si la deja pasar desde el cliente, cualquiera puede
# fingir que su conexión en claro era segura.
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO:https

# --- Registro de auditoría de accesos (RGPD Art. 30) ---
# Sin definir, los accesos solo se escriben en la salida estándar. En producción
# apunta a un archivo que se envíe a un destino externo de solo-adición en la UE.
# Ver deploy/auditoria_centralizada.md
# AUDITORIA_LOG_PATH=/var/log/carnets/auditoria.jsonl
#
# Con la ruta definida, `manage.py revisar_auditoria` revisa el registro y avisa
# por correo (rachas de bloqueos de login, exportaciones de afiliados, accesos
# denegados). Pensado para cron, una vez por hora:
#     0 * * * * cd /ruta/al/proyecto && python manage.py revisar_auditoria
# Necesita ADMINS configurado y EMAIL_HOST para que el correo salga de verdad.

# --- Base de datos ---
# Por defecto SQLite en la carpeta del proyecto. Para PostgreSQL en subred
# privada (recomendado en producción), ver deploy/postgresql_vpc.md:
# DATABASE_ENGINE=postgresql
# DATABASE_USER=carnets_app        # usuario SIN permisos de DDL
# DATABASE_PASSWORD=
# DATABASE_HOST=10.0.1.20          # IP privada, nunca pública
# DATABASE_PORT=5432
# DATABASE_SSLMODE=verify-full     # cifra Y comprueba la identidad del servidor
# DATABASE_SSLROOTCERT=/etc/ssl/certs/carnets-db-ca.pem
# DATABASE_CONN_MAX_AGE=60

# Opcionales (tienen valor por defecto seguro si se omiten):
# DATABASE_NAME=          # ruta a un archivo sqlite alternativo (tests, etc.)
# SESSION_COOKIE_SECURE=True   # poner en True cuando se sirva por HTTPS
# CSRF_COOKIE_SECURE=True      # poner en True cuando se sirva por HTTPS
# SECURE_SSL_REDIRECT=True     # poner en True cuando se sirva por HTTPS
# SECURE_HSTS_SECONDS=31536000 # HSTS (1 año). Solo cuando TODO se sirva por HTTPS; 0/omitido = desactivado (local)
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True  # por defecto True; aplica HSTS también a subdominios
# SECURE_HSTS_PRELOAD=True             # por defecto True; permite el preload de HSTS en navegadores
# SESSION_COOKIE_AGE=1800          # segundos de inactividad antes de cerrar sesión (por defecto 1800 = 30 min)
# SESSION_EXPIRE_AT_BROWSER_CLOSE=True
# LANGUAGE_CODE=es-es          # idioma del admin/mensajes (por defecto es-es)
# TIME_ZONE=Europe/Madrid      # huso horario de presentación de fechas (por defecto Europe/Madrid)

# Email (opcional). Si se omite EMAIL_HOST, los correos se imprimen en la
# consola en vez de enviarse de verdad (modo seguro para desarrollo local).
# EMAIL_HOST=correo.cgt.org.es
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=soporte_carnets@cgt.org.es
# EMAIL_HOST_PASSWORD=            # NUNCA en texto plano en el repo; solo aquí, en el .env real del servidor
